[Unit]
Description=StockHive Node (Gunicorn)
After=network.target

[Service]
User=kinv
WorkingDirectory=/home/kinv/node
Environment="PATH=/home/kinv/node/venv/bin"
ExecStart=/home/kinv/node/venv/bin/gunicorn -w 1 -b 127.0.0.1:5000 --timeout 30 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
