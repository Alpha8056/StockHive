[Unit]
Description=StockHive Launcher (Gunicorn)
After=network.target

[Service]
User=kinv
WorkingDirectory=/home/kinv/launcher
Environment="PATH=/home/kinv/launcher/venv/bin"
Environment="STOCKPI_PUBLIC_PORT=__PUBLIC_PORT__"
ExecStart=/home/kinv/launcher/venv/bin/gunicorn -w 1 -b 127.0.0.1:8000 --timeout 30 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
