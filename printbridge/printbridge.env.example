# Copy to /etc/stockhive-printbridge.env (root-owned, chmod 600).
# The same TOKEN goes into StockHive Settings > Labels & Printer.

# CTP500 Bluetooth address (bluetoothctl devices)
PRINTER_MAC=AA:BB:CC:DD:EE:FF

# Shared secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TOKEN=change-me

# Optional
PORT=8765
BIND=0.0.0.0
RFCOMM_CHANNEL=1
